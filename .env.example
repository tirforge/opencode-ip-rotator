# ---------------------------------------------------------------------------
# Required on Vercel (the service fails closed without it)
# ---------------------------------------------------------------------------
# One key, or several comma-separated keys (comma separated = multiple clients).
PROXY_API_KEY=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Abuse protection (optional)
# ---------------------------------------------------------------------------
# Requests allowed per key+IP inside each window.
PROXY_RATE_LIMIT=60
PROXY_RATE_WINDOW=60
# Optional comma-separated client IP allowlist. Leave empty to allow everyone.
PROXY_IP_ALLOWLIST=

# ---------------------------------------------------------------------------
# Proxy / model behaviour (optional)
# ---------------------------------------------------------------------------
DEFAULT_MODEL=big-pickle
# Accept any model id (gpt-*, claude-*, ...) and route unknown ones to a free model.
ALL_MODELS=1
ALL_MODELS_TARGET=big-pickle
# Exact id -> free model overrides, JSON object.
MODEL_ALIASES={"gpt-4o":"big-pickle"}
# Reasoning effort applied when the client sends none (chat/responses only).
# A "#effort" suffix or an explicit client reasoning_effort always wins.
DEFAULT_REASONING_EFFORT=medium
# Native Cloudflare WARP proxy (warp-cli mode proxy) used for IP rotation.
WARP_PROXY_URL=http://127.0.0.1:40000
# Seconds between scheduled WARP rotations; 0 disables periodic rotation.
WARP_ROTATION_INTERVAL=300
# Outbound proxy rotation. Comma-separated http(s)/socks5 URLs.
# This is the only kind of IP rotation available on Vercel (no WARP).
PROXY_LIST=
CUSTOM_OUTBOUND_PROXY=
MODEL_DISCOVERY_INTERVAL=300
STREAM_TIMEOUT=120
LOG_LEVEL=INFO
# Comma-separated browser origins, e.g. https://myapp.example.com
CORS_ALLOW_ORIGINS=
